# ── Muna's Haven environment ──────────────────────────────
# Public: safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: NEVER expose to the client. Only used by lib/supabaseAdmin.ts
# (owner-only writes for the future /admin area). Keep out of git and chat.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production URL of the storefront, e.g. https://muna-haven.vercel.app
# Used to build the shareable product link in WhatsApp enquiry messages.
NEXT_PUBLIC_SITE_URL=
